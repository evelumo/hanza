# Copy to .env — one file at the repo root is read by web, worker and Prisma.

# Host ports are non-default (5442 / 6389) so they don't clash with local services.
DATABASE_URL=postgresql://hanza:hanza@localhost:5442/hanza
REDIS_URL=redis://localhost:6389

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Seals Connection credentials (AES-256-GCM). Generate with: openssl rand -base64 32
# Losing it makes existing Connections unusable (sign in to the connector again).
HANZA_ENCRYPTION_KEY=

# Jobs the worker runs at once (positive integer). Default 10.
# WORKER_CONCURRENCY=10

# Prefix of the queue's keys in Redis (BullMQ's "bull" when unset). Web and worker must agree.
# `pnpm test:e2e` sets its own per run; leave it unset otherwise.
# HANZA_QUEUE_PREFIX=

# Installation settings of connectors: HANZA_CONNECTOR_<CONNECTOR ID>_<FIELD>, read by web and worker
# at start. A connector whose required settings are missing is listed as "not set up" and cannot be
# connected. Restart web and worker after a change.
#
# Allegro: register a device-flow application ("without access to a browser or keyboard") at
# https://apps.developer.allegro.pl (sandbox: https://apps.developer.allegro.pl.allegrosandbox.pl).
# Never share the client secret. Allegro cannot be connected until the Client ID, the secret and the name are set.
# The application's Client ID, from its registration:
# HANZA_CONNECTOR_ALLEGRO_CLIENT_ID=
# Its client secret:
# HANZA_CONNECTOR_ALLEGRO_CLIENT_SECRET=
# `production` (the default) or `sandbox`:
# HANZA_CONNECTOR_ALLEGRO_ENVIRONMENT=sandbox
# The registered application's name, exactly; it goes into the User-Agent that Allegro's terms require:
# HANZA_CONNECTOR_ALLEGRO_APP_NAME=
#
# The in-memory test connector with an OAuth sign-in ("Test OAuth channel"); any values enable it.
# HANZA_CONNECTOR_FAKE_OAUTH_CLIENT_ID=demo-client
# HANZA_CONNECTOR_FAKE_OAUTH_CLIENT_SECRET=demo-secret

# Database-backed tests create a throwaway database on this server per run.
# Unset it to skip those tests.
HANZA_TEST_DATABASE_URL=postgresql://hanza:hanza@localhost:5442/hanza
