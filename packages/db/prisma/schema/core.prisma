// Core tables. Every tenant-owned table carries `organizationId`.

/// Append-only log of everything that happened in the system.
model EventLog {
  id             String   @id @default(uuid(7))
  organizationId String
  type           String
  payload        Json     @default("{}")
  createdAt      DateTime @default(now())
  /// "product" | "offer" | "order" | "connection" | "warehouse" | "order_status"; null for system Events such as system.ping.
  subjectType    String?
  subjectId      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, subjectType, subjectId, createdAt(sort: Desc)])
  @@map("event_log")
}
