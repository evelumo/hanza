// Connections to connectors and the per-stream sync bookkeeping.

enum ConnectionHealth {
  unknown
  ok
  failing
  auth_expired

  @@map("connection_health")
}

enum SyncStream {
  offers_pull
  orders_pull
  stock_push
  order_status_push
  price_push

  @@map("sync_stream")
}

enum SyncErrorKind {
  auth_expired
  rate_limited
  transient
  permanent

  @@map("sync_error_kind")
}

model Connection {
  id              String           @id @default(uuid(7))
  organizationId  String
  /// Connector id from the registry, e.g. "fake".
  connectorId     String
  name            String
  /// Non-secret settings, validated against the connector's `configSchema`.
  config          Json
  /// Sealed with HANZA_ENCRYPTION_KEY, organization id as authenticated data (ADR 0006). Never selected by panel queries.
  credentials     String
  health          ConnectionHealth @default(unknown)
  healthChangedAt DateTime?
  /// Safety buffer: units of Available this Channel is never told about. CHECK >= 0 (ADR 0013).
  safetyBuffer    Int              @default(0)
  /// Channel limit: the most units this Channel is told; null means no limit. CHECK null or >= 0 (ADR 0013).
  channelLimit    Int?
  /// True: this Channel counts every active Warehouse, including ones added later. False: only its `warehouses` rows (ADR 0017).
  allWarehouses   Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offers       Offer[]
  orders       Order[]
  syncStates   SyncState[]
  warehouses   ConnectionWarehouse[]

  @@index([organizationId, connectorId])
  @@map("connection")
}

/// The Warehouses a Channel counts when its `allWarehouses` is false. Only active Warehouses are ever added (ADR 0017).
model ConnectionWarehouse {
  organizationId String
  connectionId   String
  warehouseId    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   Connection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([connectionId, warehouseId])
  @@index([organizationId, warehouseId])
  @@map("connection_warehouse")
}

model SyncState {
  id              String         @id @default(uuid(7))
  organizationId  String
  connectionId    String
  stream          SyncStream
  /// Persisted only for `orders_pull`.
  cursor          String?
  lastStartedAt   DateTime?
  lastFinishedAt  DateTime?
  lastSucceededAt DateTime?
  /// Counts from the last successful run, e.g. { "imported": 3 }.
  lastResult      Json?
  lastErrorKind   SyncErrorKind?
  /// Truncated to 1000 characters; cleared on success.
  lastError       String?
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   Connection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, stream])
  @@index([organizationId])
  @@map("sync_state")
}
