// Connections to connectors and the per-stream sync bookkeeping.

enum ConnectionHealth {
  unknown
  ok
  failing
  auth_expired

  @@map("connection_health")
}

enum SyncStream {
  offers_pull
  orders_pull
  stock_push
  order_status_push
  price_push

  @@map("sync_stream")
}

enum SyncErrorKind {
  auth_expired
  rate_limited
  transient
  permanent

  @@map("sync_error_kind")
}

model Connection {
  id              String           @id @default(uuid(7))
  organizationId  String
  /// Connector id from the registry, e.g. "fake".
  connectorId     String
  name            String
  /// Non-secret settings, validated against the connector's `configSchema`.
  config          Json
  /// Sealed with HANZA_ENCRYPTION_KEY, organization id as authenticated data (ADR 0006). Never selected by panel queries.
  credentials     String
  /// Bumped on every write of `credentials` (refresh, sign-in); a refresh writes only if it is unchanged (ADR 0020).
  credentialsVersion  Int       @default(0)
  /// When the access token in `credentials` expires, as the connector reports it. Not secret.
  credentialsExpireAt DateTime?
  /// The account on the Channel the credentials belong to, from a sign-in. "Sign in again" refuses a different one.
  accountId           String?
  /// Shown in the panel, e.g. the seller's login on the Channel. Not secret.
  accountLabel        String?
  health          ConnectionHealth @default(unknown)
  healthChangedAt DateTime?
  /// Safety buffer: units of Available this Channel is never told about. CHECK >= 0 (ADR 0013).
  safetyBuffer    Int              @default(0)
  /// Channel limit: the most units this Channel is told; null means no limit. CHECK null or >= 0 (ADR 0013).
  channelLimit    Int?
  /// True: this Channel counts every active Warehouse, including ones added later. False: only its `warehouses` rows (ADR 0017).
  allWarehouses   Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offers         Offer[]
  orders         Order[]
  syncStates     SyncState[]
  warehouses     ConnectionWarehouse[]
  statusMappings ChannelStatusMapping[]
  signIns        ConnectionSignIn[]

  @@index([organizationId, connectorId])
  // One Connection per Channel account in an organization; NULLs are distinct, so Connections without an account are unaffected.
  @@unique([organizationId, connectorId, accountId])
  @@map("connection")
}

enum SignInStatus {
  starting
  pending
  approved
  denied
  expired
  failed
  account_mismatch
  account_in_use
  cancelled

  @@map("sign_in_status")
}

/// An interactive sign-in (OAuth device flow) for a new Connection or one that must sign in again.
model ConnectionSignIn {
  id                      String       @id @default(uuid(7))
  organizationId          String
  connectorId             String
  /// The Connection that signs in again; for a new one, null until it is created on approval.
  connectionId            String?
  /// For a new Connection: its name and the config validated against the connector's `configSchema`.
  name                    String?
  config                  Json?
  status                  SignInStatus @default(starting)
  /// Shown to the person, who types it on the Channel's page. Not secret on its own.
  userCode                String?
  verificationUri         String?
  verificationUriComplete String?
  /// Sealed, organization id and row id as authenticated data; cleared once the sign-in ends. Never selected by panel queries.
  deviceCode              String?
  intervalSeconds         Int?
  /// A sign-in still starting or pending after this is expired by `sync.tick`.
  expiresAt               DateTime
  lastPolledAt            DateTime?
  /// The Channel account that approved, for the panel (e.g. when it was refused).
  accountLabel            String?
  /// The Channel account id the approval reported, kept with `approvedCredentials`.
  accountId               String?
  /// Credentials of an approval, sealed like `deviceCode`, stored before they are applied: a device code yields them
  /// only once, so a failed completion is retried from here. Cleared once the sign-in ends.
  approvedCredentials     String?
  createdByUserId         String?
  finishedAt              DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   Connection?  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([connectionId])
  // `sync.tick` expires and removes sign-ins by time, across organizations.
  @@index([status, expiresAt])
  @@map("connection_sign_in")
}

/// The Warehouses a Channel counts when its `allWarehouses` is false. Only active Warehouses are ever added (ADR 0017).
model ConnectionWarehouse {
  organizationId String
  connectionId   String
  warehouseId    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   Connection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([connectionId, warehouseId])
  @@index([organizationId, warehouseId])
  @@map("connection_warehouse")
}

model SyncState {
  id              String         @id @default(uuid(7))
  organizationId  String
  connectionId    String
  stream          SyncStream
  /// Persisted only for `orders_pull`.
  cursor          String?
  lastStartedAt   DateTime?
  lastFinishedAt  DateTime?
  lastSucceededAt DateTime?
  /// Counts from the last successful run, e.g. { "imported": 3 }.
  lastResult      Json?
  lastErrorKind   SyncErrorKind?
  /// Truncated to 1000 characters; cleared on success.
  lastError       String?
  /// `orders_pull` only: when a run first read the Order feed to its end since the Connection was created or the feed
  /// restarted (cleared then). Until it is set, the Connection's stock push is held (issue #125).
  caughtUpAt      DateTime?
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   Connection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, stream])
  @@index([organizationId])
  @@map("sync_state")
}
