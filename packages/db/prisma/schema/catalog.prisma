// Catalog: Products (owned by Hanza) and Offers (pulled from Channels).

model Product {
  id              String   @id @default(uuid(7))
  organizationId  String
  sku             String
  name            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  /// Optional membership of one Product family; it never changes what the Product is.
  familyId        String?
  /// One value per attribute of the family, e.g. `{ "Size": "M" }`; set exactly when `familyId` is.
  attributeValues Json?
  /// The values trimmed and case-folded, in the family's attribute order: what makes a combination unique within a family.
  attributeKey    String?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Composite so a Product can only join a family of its own organization. Ungrouping is done by the services (a
  /// composite foreign key cannot null just one of its columns), hence NoAction.
  family       ProductFamily? @relation(fields: [familyId, organizationId], references: [id, organizationId], onDelete: NoAction)
  stock        Stock[]
  offers       Offer[]
  orderLines   OrderLine[]
  reservations Reservation[]

  @@unique([organizationId, sku])
  // Partial on purpose: Postgres treats the columns of a non-partial unique index as "key" columns, so updating them
  // would lock the Product row FOR UPDATE and conflict with the FOR KEY SHARE that Order lines, Reservations, Stock and
  // Offers take through their foreign keys (deadlocks with Order import). Needs the `partialIndexes` preview feature.
  @@unique([familyId, attributeKey], where: raw("\"familyId\" IS NOT NULL"))
  @@index([organizationId, name])
  @@index([organizationId, familyId])
  @@map("product")
}

/// A group of Products that are sizes/colours of one another. Only a grouping: Orders, Stock, Reservations and Offers
/// keep pointing at the Products.
model ProductFamily {
  id             String   @id @default(uuid(7))
  organizationId String
  name           String
  /// Names of the Family attributes ("Size", "Colour"), in display order; fixed after creation.
  attributes     String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([id, organizationId])
  @@index([organizationId, name])
  @@map("product_family")
}

enum OfferLinkMethod {
  sku
  manual

  @@map("offer_link_method")
}

model Offer {
  id                  String           @id @default(uuid(7))
  organizationId      String
  connectionId        String
  externalId          String
  sku                 String?
  name                String
  url                 String?
  productId           String?
  linkedBy            OfferLinkMethod?
  /// Incremented whenever the linked Product's Available may have changed.
  stockPushSeq        Int              @default(0)
  /// The `stockPushSeq` value last pushed successfully; the Offer needs a push while `stockPushSeq > stockPushedSeq`.
  stockPushedSeq      Int              @default(0)
  lastPushedAvailable Int?
  lastPushedAt        DateTime?
  lastSeenAt          DateTime
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   Connection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([connectionId, externalId])
  @@index([organizationId, productId])
  @@index([organizationId, sku])
  @@index([connectionId, productId])
  @@map("offer")
}
